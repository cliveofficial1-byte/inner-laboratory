* {
    box-sizing: border-box;
}

:root {
    --mouse-x: 0.5;
    --mouse-y: 0.5;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
}

body {
    overflow: hidden;

    background: #f3f1eb;

    color: #25272a;

    font-family:
        Arial,
        Helvetica,
        sans-serif;
}


/* WORLD */

#laboratory {
    position: relative;

    width: 100%;
    height: 100vh;
    height: 100svh;

    overflow: hidden;
}


/* LIGHT */

.atmosphere {
    position: absolute;

    width: 65vw;
    height: 65vw;

    max-width: 750px;
    max-height: 750px;

    left: calc(
        50% + (var(--mouse-x) - 0.5) * 70px
    );

    top: calc(
        50% + (var(--mouse-y) - 0.5) * 70px
    );

    transform: translate(-50%, -50%);

    background:
        radial-gradient(
            circle,
            rgba(196, 219, 207, 0.75),
            rgba(206, 215, 235, 0.35) 32%,
            rgba(230, 215, 238, 0.16) 52%,
            transparent 72%
        );

    filter: blur(18px);

    transition:
        left 2s ease-out,
        top 2s ease-out;

    animation:
        breathing 9s ease-in-out infinite;
}


/* SCREENS */

.screen {
    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    opacity: 0;

    pointer-events: none;

    transform:
        scale(1.02);

    transition:
        opacity 1s ease,
        transform 1.2s ease;
}

.screen.active {
    opacity: 1;

    pointer-events: auto;

    transform:
        scale(1);
}


/* PRESENCE */

.centre {
    position: relative;

    z-index: 2;

    text-align: center;
}


.orb {
    border: 0;

    width: 48px;
    height: 48px;

    margin-bottom: 22px;

    border-radius: 50%;

    background: transparent;

    color: #55595b;

    font-size: 28px;

    cursor: default;

    transition:
        transform 1s ease,
        background 1s ease,
        box-shadow 1s ease;
}


.orb.ready {
    cursor: pointer;

    background:
        rgba(255, 255, 255, 0.45);

    box-shadow:
        0 0 45px
        rgba(185, 210, 205, 0.45);

    animation:
        invitation 2.5s ease-in-out infinite;
}


.orb.ready:hover {
    transform: scale(1.18);
}


h1 {
    margin: 0;

    font-size: clamp(
        2.2rem,
        6vw,
        5.5rem
    );

    font-weight: 400;

    letter-spacing: -0.055em;

    line-height: 0.95;
}


#whisper {
    margin-top: 30px;

    font-size: 0.9rem;

    letter-spacing: 0.04em;

    color: #686b6d;

    transition:
        opacity 0.7s ease,
        transform 0.7s ease;
}


#whisper.fade,
.fade {
    opacity: 0;

    transform:
        translateY(5px);
}


/* CORNER */

.corner {
    position: absolute;

    bottom: 25px;
    right: 28px;

    z-index: 3;

    font-size: 10px;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: #969794;
}


/* ENTRANCE */

.entrance-content {
    width: min(620px, 90vw);

    text-align: center;
}


.eyebrow {
    margin-bottom: 25px;

    font-size: 10px;

    letter-spacing: 0.2em;

    color: #929491;
}


.entrance h2 {
    margin: 0 0 45px;

    font-size: clamp(
        2rem,
        5vw,
        4rem
    );

    font-weight: 400;

    letter-spacing: -0.045em;
}


.choices {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 3px;
}


.choices button {
    border: 0;

    background: transparent;

    padding: 9px 18px;

    color: #55595b;

    font-family: inherit;

    font-size: 1rem;

    cursor: pointer;

    transition:
        color 0.3s ease,
        transform 0.3s ease;
}


.choices button:hover {
    color: #202326;

    transform:
        translateX(5px);
}


.small-note {
    margin-top: 42px;

    font-size: 0.75rem;

    color: #999b98;
}


/* LAB */

.inside-content {
    width: min(850px, 90vw);

    text-align: center;
}


.inside-content h2 {
    margin: 0;

    font-size: clamp(
        2.5rem,
        7vw,
        6rem
    );

    font-weight: 400;

    letter-spacing: -0.06em;
}


#response-text {
    max-width: 500px;

    margin: 25px auto 65px;

    color: #686b6d;

    line-height: 1.7;
}


.doors {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 10px;
}


.doors button {
    min-height: 120px;

    padding: 20px;

    border: 1px solid
        rgba(50, 50, 50, 0.08);

    border-radius: 20px;

    background:
        rgba(255, 255, 255, 0.28);

    color: #404346;

    font-family: inherit;

    font-size: 1rem;

    cursor: pointer;

    transition:
        transform 0.4s ease,
        background 0.4s ease,
        border 0.4s ease;
}


.doors button:hover {
    transform:
        translateY(-5px);

    background:
        rgba(255, 255, 255, 0.55);
}


.doors span {
    display: block;

    margin-bottom: 15px;

    font-size: 9px;

    letter-spacing: 0.15em;

    color: #999b98;
}


/* ROOMS */

.room-content {
    width: min(750px, 90vw);

    text-align: center;
}


.room-content h2 {
    margin: 0;

    font-size: clamp(
        2.5rem,
        6vw,
        5rem
    );

    font-weight: 400;

    letter-spacing: -0.055em;
}


.question-symbol,
.unknown-mark {
    margin-bottom: 25px;

    font-size: 3rem;

    color: #9aa7a2;
}


#question {
    max-width: 700px;

    margin: 0 auto 45px;

    font-size: clamp(
        1.8rem,
        4vw,
        3.2rem
    );

    line-height: 1.2;

    transition:
        opacity 0.5s ease,
        transform 0.5s ease;
}


.quiet-button {
    border: 1px solid
        rgba(50, 50, 50, 0.12);

    border-radius: 100px;

    padding: 12px 20px;

    background:
        rgba(255, 255, 255, 0.25);

    color: #55595b;

    font-family: inherit;

    cursor: pointer;

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}


.quiet-button:hover {
    background:
        rgba(255, 255, 255, 0.55);

    transform:
        translateY(-2px);
}


.back {
    display: block;

    margin: 55px auto 0;

    border: 0;

    background: transparent;

    color: #999b98;

    font-family: inherit;

    cursor: pointer;

    transition:
        color 0.3s ease;
}


.back:hover {
    color: #404346;
}


/* MIRROR */

.mirror-content h2 {
    margin-bottom: 35px;
}


textarea {
    width: 100%;

    min-height: 180px;

    padding: 20px;

    resize: vertical;

    border: 1px solid
        rgba(50, 50, 50, 0.1);

    border-radius: 20px;

    outline: none;

    background:
        rgba(255, 255, 255, 0.35);

    color: #303336;

    font-family: inherit;

    font-size: 1rem;

    line-height: 1.6;
}


textarea:focus {
    background:
        rgba(255, 255, 255, 0.55);
}


.mirror-actions {
    margin-top: 15px;

    display: flex;

    gap: 8px;

    justify-content: center;
}


#message {
    min-height: 20px;

    margin-top: 15px;

    font-size: 0.8rem;

    color: #888b89;
}


/* EXPERIMENT */

#experiment-text {
    max-width: 500px;

    margin: 25px auto 40px;

    color: #686b6d;

    line-height: 1.7;
}


.experiment-orb {
    width: 80px;
    height: 80px;

    margin: 0 auto 35px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.25);

    color: #6d7774;

    font-size: 30px;

    transition:
        transform 5s ease,
        box-shadow 5s ease;
}


.experiment-orb.experiment-active {
    transform: scale(1.35);

    box-shadow:
        0 0 80px
        rgba(180, 210, 205, 0.5);
}


/* UNKNOWN */

#unknown-text {
    max-width: 650px;

    margin: 0 auto 45px;

    font-size: clamp(
        1.5rem,
        3vw,
        2.5rem
    );

    line-height: 1.35;

    transition:
        opacity 0.5s ease,
        transform 0.5s ease;
}


/* MOTION */

@keyframes breathing {

    0%,
    100% {
        transform:
            translate(-50%, -50%)
            scale(0.96);
    }

    50% {
        transform:
            translate(-50%, -50%)
            scale(1.04);
    }
}


@keyframes invitation {

    0%,
    100% {
        transform: scale(0.95);
    }

    50% {
        transform: scale(1.08);
    }
}


/* PHONE */

@media (max-width: 700px) {

    .atmosphere {
        width: 120vw;
        height: 120vw;
    }

    .doors {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .doors button {
        min-height: 100px;
    }

    .corner {
        right: 18px;
        bottom: 18px;
    }
}
