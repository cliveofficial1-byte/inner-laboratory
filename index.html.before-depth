<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>The Inner Laboratory</title>

    <meta name="description"
          content="The Inner Laboratory — a quiet digital space for questions, awareness, creativity and discovery.">

    <link rel="stylesheet" href="style.css">
</head>

<body>

<main id="laboratory">

    <button type="button" class="lab-mark" id="labMark" aria-label="Return to the beginning">
        ◦
    </button>

    <div class="atmosphere"></div>


    <!-- PRESENCE -->

    <section id="presence" class="screen active">

        <div class="centre">

            <button id="orb" class="orb">
                ◦
            </button>

            <h1>The Inner Laboratory</h1>

            <p id="whisper">
                nothing needs to happen
            </p>

        </div>

        <div class="corner">
            digital space
        </div>

    </section>


    <!-- ENTRANCE -->

    <section id="entrance" class="screen">

        <div class="entrance-content">

            <p class="eyebrow">
                THE ENTRANCE
            </p>

            <h2>
                What brought you here?
            </h2>

            <div class="choices">

                <button onclick="enterLab('unknown')">
                    I don't know
                </button>

                <button onclick="enterLab('curious')">
                    I'm curious
                </button>

                <button onclick="enterLab('different')">
                    Something feels different
                </button>

                <button onclick="enterLab('understand')">
                    I want to understand
                </button>

                <button onclick="enterLab('wander')">
                    I just want to wander
                </button>

            </div>

            <p class="small-note">
                There is no right answer.
            </p>

        </div>

    </section>


    <!-- LABORATORY -->

    <section id="lab" class="screen">

        <div class="inside-content">

            <p class="eyebrow">
                THE LABORATORY
            </p>

            <h2 id="response">
                Good.
            </h2>

            <p id="response-text">
                You don't need to know where you're going.
            </p>


            <div class="doors">

                <button onclick="openRoom('questions')">
                    <span>01</span>
                    Questions
                </button>

                <button onclick="openRoom('mirror')">
                    <span>02</span>
                    The Mirror
                </button>

                <button onclick="openRoom('experiments')">
                    <span>03</span>
                    Experiments
                </button>

                <button onclick="openRoom('unknown')">
                    <span>04</span>
                    The Unknown
                </button>

            </div>

        </div>

    </section>


    <!-- QUESTIONS -->

    <section id="questions" class="room screen">

        <div class="room-content">

            <p class="eyebrow">
                01 / QUESTIONS
            </p>

            <div class="question-symbol">
                ?
            </div>

            <p id="question">
                Who are you when you stop trying to become someone?
            </p>

            <button class="quiet-button"
                    onclick="newQuestion()">
                another question
            </button>

            <button class="back"
                    onclick="backToLab()">
                ← return
            </button>

        </div>

    </section>


    <!-- MIRROR -->

    <section id="mirror" class="room screen">

        <div class="room-content mirror-content">

            <p class="eyebrow">
                02 / THE MIRROR
            </p>

            <h2>
                What is here right now?
            </h2>

            <textarea
                id="thought"
                placeholder="You don't have to write something profound."></textarea>

            <div class="mirror-actions">

                <button class="quiet-button"
                        onclick="saveThought()">
                    leave it here
                </button>

                <button class="quiet-button"
                        onclick="clearThought()">
                    clear
                </button>

            </div>

            <p id="message"></p>

            <button class="back"
                    onclick="backToLab()">
                ← return
            </button>

        </div>

    </section>


    <!-- EXPERIMENTS -->

    <section id="experiments" class="room screen">

        <div class="room-content">

            <p class="eyebrow">
                03 / EXPERIMENTS
            </p>

            <h2>
                Try doing nothing.
            </h2>

            <p id="experiment-text">
                For the next few seconds, don't search for anything.
                Just watch the little point.
            </p>

            <div id="experiment-orb"
                 class="experiment-orb">
                ·
            </div>

            <button class="quiet-button"
                    onclick="startExperiment()">
                begin
            </button>

            <button class="back"
                    onclick="backToLab()">
                ← return
            </button>

        </div>

    </section>


    <!-- UNKNOWN -->

    <section id="unknown" class="room screen">

        <div class="room-content">

            <p class="eyebrow">
                04 / THE UNKNOWN
            </p>

            <div class="unknown-mark">
                ∞
            </div>

            <p id="unknown-text">
                There are things you haven't noticed yet.
            </p>

            <button class="quiet-button"
                    onclick="newUnknown()">
                show me something
            </button>

            <button class="back"
                    onclick="backToLab()">
                ← return
            </button>

        </div>

    </section>

</main>


<script>

/* -------------------------
   SCREEN CONTROL
------------------------- */

function showScreen(id) {

    document
        .querySelectorAll(".screen")
        .forEach(screen => {
            screen.classList.remove("active");
        });

    setTimeout(() => {

        document
            .getElementById(id)
            .classList.add("active");

    }, 100);
}


/* -------------------------
   FIRST ENTRANCE
------------------------- */

const orb =
    document.getElementById("orb");

const whisper =
    document.getElementById("whisper");


const whispers = [
    "nothing needs to happen",
    "you can stay here",
    "there is nowhere to get to",
    "look around",
    "take your time",
    "this is only a screen",
    "and yet, here you are"
];


let whisperIndex = 0;


const whisperTimer = setInterval(() => {

    whisperIndex =
        (whisperIndex + 1) % whispers.length;

    whisper.classList.add("fade");

    setTimeout(() => {

        whisper.textContent =
            whispers[whisperIndex];

        whisper.classList.remove("fade");

    }, 700);

}, 5000);


setTimeout(() => {

    clearInterval(whisperTimer);

    whisper.classList.add("fade");

    setTimeout(() => {

        whisper.textContent =
            "enter the space";

        whisper.classList.remove("fade");

        orb.classList.add("ready");

    }, 700);

}, 11000);


orb.addEventListener("click", () => {

    showScreen("entrance");

});


whisper.addEventListener("click", () => {

    if (orb.classList.contains("ready")) {
        showScreen("entrance");
    }

});


/* -------------------------
   ENTRANCE RESPONSE
------------------------- */

function enterLab(choice) {

    const response =
        document.getElementById("response");

    const responseText =
        document.getElementById("response-text");


    if (choice === "unknown") {

        response.textContent = "Good.";

        responseText.textContent =
            "You don't need to know where you're going.";

    }

    if (choice === "curious") {

        response.textContent =
            "Then look around.";

        responseText.textContent =
            "Curiosity doesn't always need somewhere to go.";

    }

    if (choice === "different") {

        response.textContent =
            "Notice it.";

        responseText.textContent =
            "You don't have to name it yet.";

    }

    if (choice === "understand") {

        response.textContent =
            "Maybe.";

        responseText.textContent =
            "Understanding sometimes begins before an answer.";

    }

    if (choice === "wander") {

        response.textContent =
            "Then wander.";

        responseText.textContent =
            "You don't have to find anything.";

    }


    showScreen("lab");

}


/* -------------------------
   OPEN ROOMS
------------------------- */

function openRoom(room) {

    showScreen(room);

}


/* -------------------------
   QUESTIONS
------------------------- */



const questions = [

    "Who are you when you stop trying to become someone?",

    "Is a thought something you are, or something you experience?",

    "What remains when you don't need to impress anyone?",

    "How much of your identity was chosen by you?",

    "What do you notice when you stop looking for an answer?",

    "If nobody could see you, what would you do differently?",

    "What is the difference between being alone and being with yourself?",

    "What have you been assuming is true?",

    "What happens before you decide what you think?",

    "Could you meet yourself without describing yourself?"
];


function newQuestion() {

    const question =
        document.getElementById("question");

    let random =
        Math.floor(
            Math.random() * questions.length
        );

    question.classList.add("fade");

    setTimeout(() => {

        question.textContent =
            questions[random];

        question.classList.remove("fade");

    }, 500);

}


/* -------------------------
   MIRROR
------------------------- */

function saveThought() {

    const thought =
        document.getElementById("thought").value;

    const message =
        document.getElementById("message");


    if (thought.trim() === "") {

        message.textContent =
            "There is nothing to leave here yet.";

        return;
    }


    localStorage.setItem(
        "innerLaboratoryThought",
        thought
    );


    message.textContent =
        "It stays here, on this device.";
}


function clearThought() {

    document.getElementById("thought").value = "";

    document.getElementById("message").textContent = "";

    localStorage.removeItem(
        "innerLaboratoryThought"
    );

}


/* -------------------------
   EXPERIMENT
------------------------- */

function startExperiment() {

    const text =
        document.getElementById("experiment-text");

    const orb =
        document.getElementById("experiment-orb");


    text.textContent =
        "Watch the point. Don't try to make anything happen.";


    orb.classList.add("experiment-active");


    setTimeout(() => {

        text.textContent =
            "Notice how quickly the mind wants something to happen.";

    }, 5000);


    setTimeout(() => {

        text.textContent =
            "That wanting is also something you can notice.";

    }, 10000);

}


/* -------------------------
   UNKNOWN
------------------------- */

const unknowns = [

    "You have never experienced the present moment anywhere else.",

    "The version of you from five years ago is gone, but somehow you still call it 'me'.",

    "You can notice a thought without knowing where it came from.",

    "Most of what surrounds you becomes invisible through familiarity.",

    "You are looking at light produced by a machine, and somehow it became a place.",

    "There are probably things happening around you right now that you have never noticed.",

    "The screen is not the experience. Your experience of the screen is.",

    "Something can be meaningless and still be beautiful."
];


function newUnknown() {

    const text =
        document.getElementById("unknown-text");


    const random =
        Math.floor(
            Math.random() * unknowns.length
        );


    text.classList.add("fade");


    setTimeout(() => {

        text.textContent =
            unknowns[random];

        text.classList.remove("fade");

    }, 500);

}


/* -------------------------
   RETURN
------------------------- */

function backToLab() {

    showScreen("lab");

}


/* -------------------------
   DIGITAL SPACE RESPONDS
------------------------- */

document.addEventListener(
    "mousemove",
    event => {

        const x =
            event.clientX /
            window.innerWidth;

        const y =
            event.clientY /
            window.innerHeight;


        document.documentElement
            .style
            .setProperty(
                "--mouse-x",
                x
            );


        document.documentElement
            .style
            .setProperty(
                "--mouse-y",
                y
            );

    }
);

</script>

</body>
</html>
